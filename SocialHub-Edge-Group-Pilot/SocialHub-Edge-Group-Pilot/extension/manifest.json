{
  "manifest_version": 3,
  "name": "SocialHub — Facebook Group One-Task Pilot",
  "description": "One-task Group Pilot using explicit browser-keyboard confirmation. No automatic publishing.",
  "version": "0.2.1",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SocialHub Group Pilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/groups/*",
        "https://facebook.com/groups/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
